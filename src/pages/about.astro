---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SectionTitle from '../components/SectionTitle.astro';
import Icon from '../components/Icon.astro';
import SkillsGrid from '../components/SkillsGrid.astro';
import { boldParts } from '../lib/bold';
import { SITE, EXPERIENCE, OTHER_SKILLS } from '../consts';
---

<Base
  title="About"
  description="About Sodya - Unity developer, 3 years shipping mobile games on Android and iOS, with hands-on ASP.NET Core backend experience."
>
  <Header />

  <main id="main" class="container-page pt-14 pb-16 sm:pt-16">
    <h1 class="text-3xl font-bold tracking-tight text-ink-50 sm:text-4xl">About</h1>

    <div class="mt-8 grid gap-12 lg:grid-cols-[minmax(0,1fr)_20rem] lg:gap-16">
      <div>
<div class="space-y-5 text-base leading-relaxed text-ink-200">
          <p>
            Unity Developer with {SITE.years} years of experience building and shipping
            Android/iOS games, from gameplay prototypes to production releases.
          </p>
          <p>
            I build reusable gameplay systems, development tools, and client-server features
            using Unity, C#, and ASP.NET Core. Comfortable owning features end to end, from
            implementation to integration and release.
          </p>
        </div>

        <section class="mt-16">
          <SectionTitle index="01" title="Experience" />
          <div class="mt-8 space-y-4">
            {
              EXPERIENCE.map((job) => (
                <article class="panel panel-hover overflow-hidden">
                  <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 border-b border-ink-700 bg-ink-850 px-5 py-3">
                    <div class="flex flex-wrap items-baseline gap-x-3">
                      <h3 class="font-mono text-base font-semibold text-ink-50">{job.company}</h3>
                      <span class="text-sm text-ink-400">{job.role}</span>
                    </div>
                    <div class="flex items-center gap-3 font-mono text-xs text-ink-400">
                      <span>{job.period}</span>
                      <span class="rounded-[2px] border border-ink-600 px-1.5 py-0.5 text-ink-400">
                        {job.mode}
                      </span>
                    </div>
                  </div>
                  <div class="px-5 py-5">
                    <p class="text-sm leading-relaxed text-ink-300 italic">{job.blurb}</p>
                    {"storeLink" in job && job.storeLink && (
                      <a href={job.storeLink.href} target="_blank" rel="noopener noreferrer" class="btn btn-ghost btn-sm mt-5">
                        <Icon name="googleplay" class="h-3.5 w-3.5" />
                        {job.storeLink.label}
                      </a>
                    )}
                    <ul class="mt-4 space-y-2.5">
                      {job.points.map((point) => (
                        <li class="flex gap-3 text-sm leading-relaxed text-ink-200">
                          <span class="mt-[0.45rem] h-1 w-1 shrink-0 rounded-full bg-accent-500" />
                          <span>
                            {boldParts(point).map((part) =>
                              part.bold ? (
                                <strong class="font-semibold text-ink-50">{part.text}</strong>
                              ) : (
                                part.text
                              )
                            )}
                          </span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </article>
              ))
            }
          </div>
        </section>

        <section class="mt-16">
          <SectionTitle index="02" title="Skills" />
<div class="mt-8">
        <SkillsGrid />
      </div>
        </section>

        <section class="mt-16">
          <SectionTitle index="03" title="Other skills" note="all basic level" />
          <div class="mt-8 grid gap-px overflow-hidden rounded-[3px] border border-ink-700 bg-ink-700 sm:grid-cols-2">
            {
              OTHER_SKILLS.map((skill) => (
                <div class="flex items-baseline gap-3 bg-ink-900 p-5">
                  <span class="font-mono text-sm font-medium text-ink-100">{skill.name}</span>
                  <span class="text-sm text-ink-400">{skill.detail}</span>
                </div>
              ))
            }
          </div>
        </section>
      </div>

      <!-- side panel -->
      <aside class="space-y-4 lg:sticky lg:top-20 lg:self-start">
        <div class="panel p-5">
          <p class="border-b border-ink-700 pb-3 font-mono text-xs text-ink-400">details</p>
          <dl class="mt-4 space-y-3 font-mono text-xs">
            <div class="flex items-baseline justify-between gap-4">
              <dt class="text-ink-400">Handle</dt>
              <dd class="text-right text-ink-100">{SITE.name}</dd>
            </div>
            <div class="flex items-baseline justify-between gap-4">
              <dt class="text-ink-400">Based in</dt>
              <dd class="text-right text-ink-100">Armenia</dd>
            </div>
            <div class="flex items-baseline justify-between gap-4">
              <dt class="text-ink-400">Timezone</dt>
              <dd class="text-right text-ink-100">UTC+4</dd>
            </div>
            <div class="flex items-baseline justify-between gap-4">
              <dt class="text-ink-400">Remote</dt>
              <dd class="text-right text-ink-100">Yes, worldwide</dd>
            </div>
            <div class="flex items-baseline justify-between gap-4">
              <dt class="text-ink-400">Languages</dt>
              <dd class="text-right text-ink-100">EN C1, RU native</dd>
            </div>
            <div class="flex items-baseline justify-between gap-4">
              <dt class="text-ink-400">Focus</dt>
              <dd class="text-right text-ink-100">Mobile, client-server</dd>
            </div>
            <div class="flex items-baseline justify-between gap-4">
              <dt class="text-ink-400 select-none">
                <a
                  href="/murli"
                  class="text-ink-800 transition-colors hover:text-accent-500 focus-visible:text-accent-500"
                  aria-label="Murli"
                >
                  Murli
                </a>
              </dt>
              <dd class="text-right">
                <a
                  href="/murli"
                  class="text-ink-800 transition-colors hover:text-accent-500 focus-visible:text-accent-500"
                  aria-label="Murli"
                >
                  Murli
                </a>
              </dd>
            </div>
          </dl>
        </div>

        <div class="panel p-5">
          <p class="border-b border-ink-700 pb-3 font-mono text-xs text-ink-400">other links</p>
          <div class="mt-4 flex items-center gap-2.5">
            <a
              href={SITE.github}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="GitHub"
              class="flex h-8 w-8 items-center justify-center rounded-[2px] border border-ink-600 bg-ink-800 text-ink-300 transition-colors hover:border-accent-500 hover:text-accent-400"
            >
              <Icon name="github" class="h-4 w-4" />
            </a>
            <a
              href={SITE.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="LinkedIn"
              class="flex h-8 w-8 items-center justify-center rounded-[2px] border border-ink-600 bg-ink-800 text-ink-300 transition-colors hover:border-accent-500 hover:text-accent-400"
            >
              <Icon name="linkedin" class="h-4 w-4" />
            </a>
            <a
              href={SITE.telegram}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Telegram"
              class="flex h-8 w-8 items-center justify-center rounded-[2px] border border-ink-600 bg-ink-800 text-ink-300 transition-colors hover:border-accent-500 hover:text-accent-400"
            >
              <Icon name="telegram" class="h-4 w-4" />
            </a>
            <span
              title="Discord: pyps1ch"
              class="flex h-8 w-8 cursor-default items-center justify-center rounded-[2px] border border-ink-600 bg-ink-800 text-ink-300"
            >
              <Icon name="discord" class="h-4 w-4" />
            </span>
            <a
              href={SITE.instagram}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Instagram"
              class="flex h-8 w-8 items-center justify-center rounded-[2px] border border-ink-600 bg-ink-800 text-ink-300 transition-colors hover:border-accent-500 hover:text-accent-400"
            >
              <Icon name="instagram" class="h-4 w-4" />
            </a>
            <a
              href={SITE.itch}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="itch.io"
              class="flex h-8 w-8 items-center justify-center rounded-[2px] border border-ink-600 bg-ink-800 text-ink-300 transition-colors hover:border-accent-500 hover:text-accent-400"
            >
              <Icon name="itch" class="h-4 w-4" />
            </a>
          </div>
          <p class="mt-4 font-mono text-[0.625rem] text-ink-400">
            Discord <span class="text-ink-400">pyps1ch</span>
          </p>
        </div>
      </aside>
    </div>
  </main>

  <Footer />
</Base>