---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';
import StoreShots from '../../components/StoreShots.astro';
import { youtubeEmbed } from '../../lib/youtube';
import { CATEGORY, STATUS } from '../../lib/labels';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const d = project.data;

const all = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const siblings = all.filter((p) => p.data.category === d.category);
const idx = siblings.findIndex((p) => p.id === project.id);
const next = siblings.length > 1 ? siblings[(idx + 1) % siblings.length] : null;

const embedUrl = youtubeEmbed(d.video);
const statusMeta = STATUS[d.status];
const categoryMeta = CATEGORY[d.category];

const links = [
  { show: Boolean(d.play), href: d.play, label: d.category === 'freelance' ? 'Steam' : 'Google Play', icon: d.category === 'freelance' ? 'steam' : 'googleplay', primary: true },
  { show: Boolean(d.itch), href: d.itch, label: 'Play on itch.io', icon: 'itch', primary: true },
  { show: Boolean(d.github), href: d.github, label: d.githubLabel ?? 'Source code', icon: 'github', primary: false },
  { show: Boolean(d.githubBackend), href: d.githubBackend, label: d.githubBackendLabel ?? 'Backend code', icon: 'github', primary: false },
  { show: Boolean(d.video), href: d.video, label: 'Gameplay video', icon: null, primary: false },
].filter((l) => l.show);
---

<Base title={d.title} description={d.summary}>
  <Header />

  <main id="main" class="container-narrow w-full min-w-0 pt-12 pb-16 sm:pt-14">
    <a href="/projects" class="font-mono text-xs text-ink-400 transition-colors hover:text-accent-400">
      &larr; back to projects
    </a>

    <!-- header block, styled like an IDE inspector header -->
    <div class="mt-6 panel">
      <div class="flex flex-wrap items-center gap-3 border-b border-ink-700 bg-ink-850 px-5 py-2.5 font-mono text-xs">
        <span
          class="status-pill"
          style={`color: ${statusMeta.color}; background-color: color-mix(in srgb, ${statusMeta.color} 18%, var(--color-ink-800));`}
        >
          {statusMeta.label}
        </span>
        <span class="flex items-center gap-1.5 text-ink-400">
          <span class="h-1.5 w-1.5 rounded-full" style={`background-color: ${categoryMeta.color}`}
          ></span>
          {categoryMeta.label}
        </span>
        <span class="text-ink-400">|</span>
        <span class="text-ink-400">{d.platform}</span>
      </div>

      <div class="p-6 sm:p-8">
        <div class="flex flex-wrap items-center gap-3">
          <h1 class="font-mono text-3xl font-bold tracking-tight text-ink-50 sm:text-4xl">
            {d.title}
          </h1>
          {
            d.client && (
              <span class="rounded-[2px] border border-ink-600 bg-ink-850 px-2 py-1 font-mono text-[0.6875rem] text-ink-300">
                {d.client}
              </span>
            )
          }
        </div>
        <p class="mt-4 max-w-2xl text-base leading-relaxed text-ink-200">{d.summary}</p>

        <!-- when it was made -->
        <div class="mt-6 flex items-center gap-3 rounded-[2px] border border-ink-700 bg-ink-850 px-4 py-3 font-mono text-xs">
          <Icon name="calendar" class="h-4 w-4 text-accent-400" />
          <span class="text-ink-400">Made</span>
          <span class="font-semibold text-ink-100">{d.year}</span>
        </div>

        <div class="mt-5 flex flex-wrap gap-1.5">
          {d.tags.map((tag) => <span class="chip">{tag}</span>)}
        </div>

        <dl class="mt-5 space-y-1.5 border-t border-ink-700 pt-5 font-mono text-xs">
          <div class="flex gap-2">
            <dt class="text-ink-400">Role:</dt>
            <dd class="text-ink-300">{d.role}</dd>
          </div>
        </dl>

        <div class="mt-6 flex flex-wrap gap-2.5">
          {
            links.map((link) => (
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class:list={['btn btn-sm', link.primary ? 'btn-primary' : 'btn-ghost']}
              >
                {link.icon && <Icon name={link.icon} class="h-3.5 w-3.5" />}
                {link.label}
              </a>
            ))
          }
        </div>
      </div>
    </div>

    {
      d.cover && (
        <div class="mt-6 flex min-w-0 justify-center overflow-hidden rounded-[3px] border border-ink-700 bg-ink-900 p-3">
          <img
            src={d.cover}
            alt={`${d.title} preview`}
            loading="lazy"
            decoding="async"
            width={d.coverWidth}
            height={d.coverHeight}
            style={`width:${Math.max(d.coverWidth ?? 640, 480)}px;max-width:100%`}
            class:list={[
              'block h-auto rounded-[2px]',
              { 'bg-ink-850 object-contain': !d.coverIsGif },
            ]}
          />
        </div>
      )
    }

    {
      embedUrl && (
        <div class="mt-6 aspect-video overflow-hidden rounded-[3px] border border-ink-700 bg-ink-900">
          <iframe
            class="h-full w-full"
            src={embedUrl}
            title={`${d.title} gameplay`}
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          />
        </div>
      )
    }

    {
      d.storeShots && d.play && (
        <StoreShots shots={d.storeShots} href={d.play} store="Google Play" />
      )
    }

    <article class="prose-project mt-10">
      <Content />
    </article>

    {
      next && (
        <div class="mt-16 border-t border-ink-700 pt-6">
          <a href={`/projects/${next.id}`} class="group flex items-center justify-between gap-6">
            <div class="min-w-0">
              <p class="font-mono text-[0.6875rem] tracking-widest text-ink-400 uppercase">
                Next in {categoryMeta.label}
              </p>
              <p class="mt-1.5 truncate font-mono text-base font-medium text-ink-100 transition-colors group-hover:text-accent-400">
                {next.data.title}
              </p>
            </div>
            <span class="shrink-0 text-ink-400 transition-transform group-hover:translate-x-1 group-hover:text-accent-400">
              &rarr;
            </span>
          </a>
        </div>
      )
    }
  </main>

  <Footer />
</Base>