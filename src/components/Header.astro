---
import { SITE } from '../consts';

const nav = [
  { href: '/', label: 'Home' },
  { href: '/projects', label: 'Projects' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header class="sticky top-0 z-50 border-b border-ink-800/80 bg-ink-950/80 backdrop-blur-md">
  <div class="container-page">
    <nav class="flex h-16 items-center justify-between">
      <a href="/" class="text-lg font-semibold tracking-tight hover:text-accent-400 transition-colors">
        {SITE.name}
      </a>
      <div class="flex items-center gap-1 sm:gap-2">
        {
          nav.map((item) => (
            <a
              href={item.href}
              class:list={[
                'rounded-lg px-3 py-1.5 text-sm font-medium transition-colors',
                isActive(item.href)
                  ? 'bg-ink-800 text-ink-100'
                  : 'text-ink-400 hover:bg-ink-800/60 hover:text-ink-100',
              ]}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))
        }
      </div>
    </nav>
  </div>
</header>