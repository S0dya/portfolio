---
import { SKILLS, SKILLS_SHORT } from '../consts';

interface Props {
  /**
   * 'full'    - every skill, grouped and boxed (About page)
   * 'short'   - prioritised subset for a fast scan (profile page)
   */
  variant?: 'full' | 'short';
}

const { variant = 'full' } = Astro.props;
const groups = variant === 'short' ? SKILLS_SHORT : SKILLS;
---

{
  variant === 'short' ? (
    <dl class="space-y-4">
      {groups.map((group) => (
        <div class="grid gap-1.5 sm:grid-cols-[11.5rem_minmax(0,1fr)] sm:items-baseline sm:gap-4">
          <dt class="font-mono text-[0.6875rem] font-semibold tracking-[0.14em] text-accent-400 uppercase sm:pt-1">
            {group.group}
          </dt>
          <dd class="flex flex-wrap items-center gap-x-2 gap-y-1 text-[0.8125rem] text-ink-200">
            {group.items.map((item, i) => (
              <>
                {i > 0 && <span class="text-ink-400 select-none" aria-hidden="true">·</span>}
                <span>{item}</span>
              </>
            ))}
          </dd>
        </div>
      ))}
    </dl>
  ) : (
    <div class="grid gap-3 sm:grid-cols-2">
      {groups.map((group) => (
        <div class="rounded-[3px] border border-ink-700 bg-ink-900 p-4">
          <h3 class="font-mono text-[0.6875rem] font-semibold tracking-[0.14em] text-accent-400 uppercase">
            {group.group}
          </h3>
          <ul class="mt-3 flex flex-wrap gap-1.5">
            {group.items.map((item) => (
              <li>
                <span class="inline-block rounded-[2px] border border-ink-700 bg-ink-850 px-2 py-[0.3rem] text-[0.8125rem] leading-tight text-ink-200">
                  {item}
                </span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  )
}