---
import { SITE } from '../consts';
---

<footer class="mt-auto border-t border-ink-800">
  <div class="container-page py-10">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <p class="font-semibold">{SITE.name}</p>
        <p class="mt-1 text-sm text-ink-400">{SITE.role}</p>
      </div>
      <div class="flex items-center gap-5 text-sm text-ink-400">
        <a href={SITE.github} class="hover:text-accent-400 transition-colors" rel="noopener noreferrer" target="_blank">
          GitHub
        </a>
        <a href={SITE.linkedin} class="hover:text-accent-400 transition-colors" rel="noopener noreferrer" target="_blank">
          LinkedIn
        </a>
        <a href={`mailto:${SITE.email}`} class="hover:text-accent-400 transition-colors">
          Email
        </a>
      </div>
    </div>
    <p class="mt-8 text-xs text-ink-600">
      {SITE.location} &middot; {SITE.availability}
    </p>
  </div>
</footer>