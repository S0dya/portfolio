---
import { CATEGORY, STATUS, type Category, type Status } from '../lib/labels';
import Icon from './Icon.astro';

interface Props {
  title: string;
  summary: string;
  href: string;
  year: string;
  platform: string;
  category: Category;
  tags: string[];
  status: Status;
  cover?: string;
  /** Card-only smaller copy. Pass only on the profile row; never on the projects grid. */
  coverThumb?: string;
  coverIsGif?: boolean;
  coverWidth?: number;
  coverHeight?: number;
  accent?: string;
  /** Shown on the card when this was paid client work. */
  client?: string;
  github?: string;
  githubLabel?: string;
  githubBackend?: string;
  githubBackendLabel?: string;
  play?: string;
  itch?: string;
  /** Action buttons only matter on the projects page, not the 3-card featured row. */
  showActions?: boolean;
}

const {
  title,
  summary,
  href,
  year,
  platform,
  category,
  tags,
  status,
  cover,
  coverThumb,
  coverIsGif = false,
  coverWidth,
  coverHeight,
  accent,
  client,
  github,
  githubLabel,
  githubBackend,
  githubBackendLabel,
  play,
  itch,
  showActions = true,
} = Astro.props;

const statusMeta = STATUS[status];
const categoryMeta = CATEGORY[category];
const accentColor = accent ?? categoryMeta.color;

/* Everything a visitor could actually open, surfaced on the card itself. */
const actions = [
  { show: Boolean(play), href: play, label: category === 'freelance' ? 'Steam' : 'Play Store', icon: category === 'freelance' ? 'steam' : 'googleplay', primary: true },
  { show: Boolean(itch), href: itch, label: 'itch.io', icon: 'itch', primary: true },
  { show: Boolean(github), href: github, label: githubLabel ?? 'Client code', icon: 'github', primary: false },
  { show: Boolean(githubBackend), href: githubBackend, label: githubBackendLabel ?? 'Backend code', icon: 'github', primary: false },
].filter((a) => a.show);
---

<article class="panel panel-hover group relative flex min-w-0 flex-col overflow-hidden">
  <!-- preview -->
  <div class="relative aspect-[16/10] overflow-hidden bg-ink-900">
    {
      cover ? (
        <img
          src={coverThumb ?? cover}
          alt={`${title} preview`}
          loading="lazy"
          decoding="async"
          width={coverWidth}
          height={coverHeight}
          class:list={[
            'h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]',
            { 'object-contain p-4 bg-ink-850': !coverIsGif && cover.endsWith('-icon.png') },
          ]}
        />
      ) : (
        <div
          class="flex h-full w-full flex-col justify-between p-5 font-mono text-xs"
          style={`background:
             linear-gradient(135deg, ${accentColor}26, transparent 62%),
             repeating-linear-gradient(135deg, ${accentColor}14 0 1px, transparent 1px 9px),
             var(--color-ink-850);`}
        >
          <span class="text-ink-400">preview pending</span>
          <div>
            <p class="text-[0.625rem] tracking-[0.18em] text-ink-400 uppercase">
              {categoryMeta.label}
            </p>
            <p class="mt-1 text-sm font-medium" style={`color: ${accentColor}`}>{title}</p>
          </div>
        </div>
      )
    }
    <span
      class="status-pill absolute top-2.5 left-2.5 backdrop-blur-sm"
      style={`color: ${statusMeta.color}; background-color: color-mix(in srgb, ${statusMeta.color} 18%, var(--color-ink-950));`}
    >
      {statusMeta.label}
    </span>
    {
      client && (
        <span class="absolute top-2.5 right-2.5 rounded-[2px] border border-ink-600 bg-ink-950/85 px-2 py-0.5 font-mono text-[0.625rem] text-ink-300 backdrop-blur-sm">
          {client}
        </span>
      )
    }
  </div>

  <!-- status bar, like an IDE tool window footer -->
  <div
    class="flex items-center gap-2 overflow-hidden border-b border-ink-700 bg-ink-850 px-4 py-1.5 font-mono text-[0.6875rem] whitespace-nowrap text-ink-300"
  >
    <span
      class="h-1.5 w-1.5 shrink-0 rounded-full"
      style={`background-color: ${categoryMeta.color}`}
    ></span>
    <span class="shrink-0">{categoryMeta.short}</span>
    <span class="shrink-0 text-ink-400" aria-hidden="true">|</span>
    <span class="truncate">{platform}</span>
    <span class="ml-auto shrink-0 text-ink-400">{year}</span>
  </div>

  <div class="flex flex-1 flex-col p-5">
    <h3 class="font-mono text-base font-semibold tracking-tight text-ink-50 transition-colors group-hover:text-accent-400">
      <a href={href} class="after:absolute after:inset-0 after:content-['']">{title}</a>
    </h3>
    <p class="mt-2.5 flex-1 text-sm leading-relaxed text-ink-300">{summary}</p>

    <div class="mt-4 flex flex-wrap gap-1.5">
      {tags.map((tag) => <span class="chip">{tag}</span>)}
    </div>

    {
      showActions && actions.length > 0 && (
        <div class="relative z-10 mt-5 flex flex-wrap gap-2 border-t border-ink-700 pt-4">
          {actions.map((a) => (
            <a
              href={a.href}
              target="_blank"
              rel="noopener noreferrer"
              class:list={['btn btn-sm', a.primary ? 'btn-primary' : 'btn-ghost']}
            >
              {a.icon && <Icon name={a.icon} class="h-3.5 w-3.5" />}
              {a.label}
            </a>
          ))}
          <a href={href} class="btn btn-sm btn-ghost ml-auto">Details</a>
        </div>
      )
    }
  </div>
</article>